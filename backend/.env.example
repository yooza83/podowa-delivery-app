# ── 서버 ──────────────────────────────────────────────
PORT=4000

# ── 접근 제어 (가족/직원 공유 비밀번호 로그인) ──────────
# 배송을 돕는 가족이 로그인할 때 사용할 공유 비밀번호
SHARED_PASSWORD=change-me
# express-session 쿠키 서명용 임의의 긴 문자열 (아무 랜덤 문자열이면 됨)
SESSION_SECRET=change-me-too
# 운영(NODE_ENV=production) 배포는 기본적으로 로그인 쿠키에 Secure 속성을 붙입니다(HTTPS 필수).
# 부득이하게 HTTPS 없이 HTTP로만 서비스해야 한다면 아래를 0으로 바꾸세요(권장하지 않음).
# COOKIE_SECURE=0

# ── TMap API 키 (SK Open API, openapi.sk.com) ───────────
# REST API 키 (지오코딩 · 경유지 최적화) — 절대 프론트에 노출되면 안 됨. 백엔드에서만 사용.
# (지도 표시용 JS 키는 여기가 아니라 frontend/.env의 VITE_TMAP_JS_APP_KEY에 넣습니다.)
TMAP_REST_APP_KEY=
# 경유지 최적화 상품 크기: 10 / 20 / 30 / 100 중 하나. 사용하려는 크기의 상품을
# openapi.sk.com에서 먼저 신청해둬야 합니다. Free 요금제는 상품별 하루 호출 한도가
# 크게 달라서(예: 100개 버전 1회/일, 20개 버전 50회/일 — 실측값, 계정마다 다를 수 있음)
# 기본값은 20으로 뒀습니다. 배송지가 20곳을 자주 넘으면 30이나 100으로 올리되,
# 해당 상품의 하루 한도를 대시보드에서 먼저 확인하세요.
TMAP_ROUTE_OPT_SIZE=20

# ── 출발지(농장) 기본값 ──────────────────────────────────
FARM_NAME=포도와농장
FARM_ADDRESS=여기에 농장 실제 주소를 입력하세요 (예: 경상북도 상주시 ○○면 ○○길 12)

# ── TMap 데이터 보관 정책 ────────────────────────────────
# TMap 이용약관상 좌표/경로 데이터는 24시간을 넘겨 보관 금지.
# 이 값(시간)이 지나면 서버 메모리 캐시(지오코딩 결과)가 자동 폐기됩니다. 24 이하 권장.
GEOCODE_CACHE_TTL_HOURS=12
